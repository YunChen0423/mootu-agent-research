{
  "name": "mootu-agent-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "build": "node build-worker.mjs",
    "build:static": "node build.mjs",
    "mujoco:bridge": "node bridge/launch.mjs",
    "mujoco:validate": "node bridge/launch.mjs --validate",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "eval": "node eval/run.mjs",
    "eval:generate": "node eval/generate-testsets.mjs",
    "eval:all": "node eval/run-suites.mjs",
    "eval:stability": "node --env-file-if-exists=.env eval/run-stability.mjs",
    "eval:stability:report": "node eval/summarize-stability.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.1.0",
    "@earendil-works/pi-ai": "^1.1.0",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
